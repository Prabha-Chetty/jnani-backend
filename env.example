# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Cloudinary (required for production — Render filesystem is ephemeral)
# Get from https://cloudinary.com → Dashboard → API Environment variable
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Faculty attendance remuneration
# Flat amount paid per day attended, regardless of minutes taught.
RATE_PER_DAY=500 