# MongoDB Configuration
MONGODB_URL=mongodb://localhost:27017/

# JWT Configuration
SECRET_KEY=your-super-secret-key-change-this-in-production

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Cloudinary (required for production — Render filesystem is ephemeral)
# Get from https://cloudinary.com → Dashboard → API Environment variable
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Faculty attendance remuneration
# A class is CLASS_LENGTH_MINUTES long; each completed class earns RATE_PER_CLASS.
CLASS_LENGTH_MINUTES=45
RATE_PER_CLASS=100 